{
  "name": "@kyaulabs/pi-images",
  "version": "0.1.0",
  "description": "Tmux-safe inline image bridge for Pi using Kitty placeholders or SIXEL",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "KYAU Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyaulabs/pi-images.git"
  },
  "homepage": "https://github.com/kyaulabs/pi-images#readme",
  "bugs": {
    "url": "https://github.com/kyaulabs/pi-images/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "sixel",
    "kitty-graphics",
    "tmux",
    "terminal-images"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "NOTICE",
    "pi-images.tmux"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint:tmux && npm test",
    "hooks:install": "git config core.hooksPath .github/hooks && chmod +x .github/hooks/commit-msg .github/hooks/pre-commit",
    "lint:tmux": "shellcheck pi-images.tmux",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
